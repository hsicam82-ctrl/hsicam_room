{
  "entities": {
    "Article": {
      "title": "제약/바이오 뉴스 기사",
      "description": "수집된 뉴스 기사와 수동 OpenAI 분석 결과",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "link": { "type": "string" },
        "publishedAt": { "type": ["string", "null"], "format": "date-time" },
        "fetchedAt": { "type": "string", "format": "date-time" },
        "source": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["approval", "clinical", "deal", "earnings", "pricing", "legal", "finance", "product", "etc"] },
        "importance": { "type": "string", "enum": ["high", "mid", "low"] },
        "reason": { "type": "string" },
        "summary": { "type": "string" },
        "memo": { "type": "string" },
        "isStarred": { "type": "boolean" },
        "isRead": { "type": "boolean" },
        "aiAnalyzed": { "type": "boolean" },
        "telegramSent": { "type": "boolean" },
        "entities": {
          "type": "object",
          "properties": {
            "companies": { "type": "array", "items": { "type": "string" } },
            "products": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "required": ["id", "title", "link", "fetchedAt", "source", "importance"]
    }
  },
  "firestore": {
    "/articles/{articleId}": {
      "schema": "Article",
      "description": "수집 기사와 수동 분석 결과 컬렉션"
    }
  }
}
