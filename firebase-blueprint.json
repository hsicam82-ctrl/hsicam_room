{
  "entities": {
    "Article": {
      "title": "Article",
      "description": "Scraped news article data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "link": { "type": "string" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "rssPublishedAt": { "type": "string" },
        "publishedAtSource": { "type": "string" },
        "fetchedAt": { "type": "string", "format": "date-time" },
        "source": { "type": "string" },
        "content": { "type": "string" },
        "isStarred": { "type": "boolean" },
        "isRead": { "type": "boolean" },
        "aiAnalyzed": { "type": "boolean" },
        "type": { "type": "string" },
        "importance": { "type": "string" },
        "reason": { "type": "string" },
        "summary": { "type": "string" },
        "memo": { "type": "string" },
        "telegramSent": { "type": "boolean" },
        "entities": {
          "type": "object",
          "properties": {
            "companies": { "type": "array", "items": { "type": "string" } },
            "products": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "required": ["id", "title", "link", "fetchedAt", "source"]
    },
    "NotificationLog": {
      "title": "Notification Log",
      "description": "Log of sent telegram notifications to prevent duplicates",
      "type": "object",
      "properties": {
        "normalizedLink": { "type": "string" },
        "normalizedTitle": { "type": "string" },
        "source": { "type": "string" },
        "sentAt": { "type": "string", "format": "date-time" },
        "telegramMessageId": { "type": "string" }
      },
      "required": ["normalizedTitle", "source"]
    },
    "SyncLog": {
      "title": "Sync Log",
      "description": "Stats for a news sync operation",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string" },
        "total": { "type": "integer" },
        "new": { "type": "integer" },
        "existing": { "type": "integer" },
        "sent": { "type": "integer" },
        "sources": { "type": "object" }
      }
    }
  },
  "firestore": {
    "articles": {
      "schema": "Article",
      "description": "All news articles"
    },
    "notifications": {
      "schema": "NotificationLog",
      "description": "Log of sent notifications"
    },
    "syncLogs": {
      "schema": "SyncLog",
      "description": "History of sync operations"
    },
    "metadata": {
      "schema": "object",
      "description": "System metadata like lastSyncAt"
    }
  }
}
