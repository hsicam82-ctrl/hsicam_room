{
  "entities": {
    "Article": {
      "title": "제약바이오 뉴스 기사",
      "description": "자동 수집 및 AI 분석된 뉴스 기사 정보",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "link": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "source": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["approval", "clinical", "deal", "earnings", "pricing", "legal", "finance", "product", "etc"] },
        "importance": { "type": "string", "enum": ["high", "mid", "low"] },
        "reason": { "type": "string" },
        "summary": { "type": "string" },
        "status": { "type": "string", "enum": ["취재 필요", "추가 취재 중", "기사화 완료", "보류"] },
        "entities": {
          "type": "object",
          "properties": {
            "companies": { "type": "array", "items": { "type": "string" } },
            "products": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "required": ["id", "title", "link", "date", "source", "importance"]
    }
  },
  "firestore": {
    "/articles/{articleId}": {
      "schema": "Article",
      "description": "수집된 뉴스 기사 컬렉션"
    }
  }
}
